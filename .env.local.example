# Copie ce fichier en .env.local puis remplis les 2 valeurs.
# Elles se trouvent dans Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Optionnel : onglet GIF ---
# console Giphy > Create an App > API Key
GIPHY_API_KEY=

# --- Optionnel : onglet Idées ---
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Notifications push ---
# Genere les 2 cles apres npm install :
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact.ideaforma@gmail.com
